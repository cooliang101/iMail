# 仅填写主机名，不包含 https://、端口或路径。DNS 必须已指向部署主机。
IMAIL_PUBLIC_HOST=mail.example.com

# 内部测试可使用 edge；固定部署应改为版本标签或 digest。
IMAIL_IMAGE=ghcr.io/cooliang101/imail:edge

# 推荐用 openssl rand -hex 32 生成并存入密钥管理系统；留空时 iMail 会在持久卷生成 master.key。
APP_MASTER_KEY=

# 首位用户初始化后关闭继续注册；通常无需修改。
IMAIL_REGISTRATION_MODE=initial-only
