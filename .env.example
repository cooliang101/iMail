PORT=8787
HOST=127.0.0.1
# 可选：SQLite 数据库与主密钥目录，默认 .data。
IMAIL_DATA_DIR=.data
# 可选：32 字节密钥的 64 位十六进制值；未设置时会在 .data/master.key 自动生成。
APP_MASTER_KEY=
# 生产部署请限制为实际 Web 地址，多个地址以英文逗号分隔。
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OAuth 回调公共基地址。生产环境必须改为 HTTPS 地址。
OAUTH_CALLBACK_BASE_URL=http://localhost:8787/api/oauth

# Google Cloud Console -> OAuth 2.0 Client（Web application）
# 回调：http://localhost:8787/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Microsoft Entra App Registration，支持组织账户与个人 Microsoft 账户
# 回调：http://localhost:8787/api/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=

# Yahoo mail-r/mail-w 必须先通过 Yahoo Developer Access 审核
# 回调：http://localhost:8787/api/oauth/yahoo/callback
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
YAHOO_MAIL_OAUTH_APPROVED=false
# YAHOO_OAUTH_REDIRECT_URI=
