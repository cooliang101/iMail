{
  "name": "imail",
  "version": "0.0.1",
  "imail": {
    "schemaVersion": 5
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"tsx watch --env-file-if-exists=.env server/entry.ts\"",
    "dev:web": "concurrently -n web,api -c cyan,green \"vite\" \"tsx watch --env-file-if-exists=.env server/entry.ts\"",
    "dev:frontend": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:service-runtime": "node scripts/build-service-runtime.mjs",
    "build:remote-runtime": "node scripts/build-remote-runtime.mjs",
    "build:remote": "npm run build:web && npm run build:remote-runtime",
    "prepare:desktop:dev": "npm run build:service-runtime && npm run dev:frontend",
    "test:desktop-release": "node scripts/smoke-tauri-release.mjs",
    "test:windows-installer": "node scripts/smoke-windows-installer.mjs",
    "test:local-daemon": "node scripts/smoke-local-daemon.mjs",
    "test:remote-release": "node scripts/smoke-remote-release.mjs",
    "test:container-release": "node scripts/smoke-container-release.mjs",
    "test:internal-release": "npm run typecheck && npm test && cargo test --manifest-path src-tauri/Cargo.toml --lib --target x86_64-pc-windows-msvc && cargo test --manifest-path src-tauri/cleanup-helper/Cargo.toml --locked && npm audit --omit=dev && npm run build:remote && npm run build:desktop:internal && npm run test:desktop-release && npm run test:local-daemon && npm run test:remote-release",
    "test:deployment-release": "npm run test:internal-release",
    "build:desktop": "tauri build",
    "build:desktop:internal": "node scripts/build-internal-desktop.mjs",
    "build:desktop:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "start": "tsx --env-file-if-exists=.env server/entry.ts",
    "start:remote": "node --env-file-if-exists=.env server-runtime/imail-server.cjs",
    "backup": "node --env-file-if-exists=.env scripts/backup-data.mjs",
    "restore:prepare": "node scripts/prepare-restore.mjs",
    "upgrade:preflight": "tsx --env-file-if-exists=.env server/maintenance/upgrade-preflight.ts",
    "worker": "tsx --env-file-if-exists=.env server/sync/worker.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.69.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "imapflow": "^1.0.195",
    "jose": "^6.2.4",
    "mailparser": "^3.7.4",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.27.1",
    "socks": "^2.8.9",
    "tldts": "^7.4.9",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "linkedom": "^0.18.13",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
