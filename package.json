{
  "name": "imail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"tsx watch --env-file-if-exists=.env server/entry.ts\"",
    "dev:web": "concurrently -n web,api -c cyan,green \"vite\" \"tsx watch --env-file-if-exists=.env server/entry.ts\"",
    "dev:frontend": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "prepare:desktop:dev": "npm run dev:frontend",
    "test:desktop-release": "node scripts/smoke-tauri-release.mjs",
    "build:desktop": "tauri build",
    "build:desktop:windows": "tauri build --bundles nsis",
    "build:desktop:macos": "tauri build --bundles dmg",
    "start": "tsx --env-file-if-exists=.env server/entry.ts",
    "worker": "tsx --env-file-if-exists=.env server/sync/worker.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.69.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "imapflow": "^1.0.195",
    "jose": "^6.2.4",
    "mailparser": "^3.7.4",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.27.1",
    "socks": "^2.8.9",
    "tldts": "^7.4.9",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "linkedom": "^0.18.13",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
