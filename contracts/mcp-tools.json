{
  "protocolVersion": "2026-07-28",
  "tools": [
    {
      "name": "imail_status",
      "title": "查看 iMail 状态",
      "description": "查看账户、邮件、未读、草稿数量与最近同步状态。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "settings_get",
      "title": "读取 iMail 设置",
      "description": "读取主题、启动页面、阅读、通知、邮件展示和快捷键偏好。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "settings_update",
      "title": "更新 iMail 设置",
      "description": "更新主题、启动页面、阅读、通知、邮件展示或快捷键偏好；未提供的字段保持不变。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "mint-fresh",
              "tech",
              "business-blue",
              "soft-neubrutalism"
            ]
          },
          "startupView": {
            "type": "string",
            "enum": [
              "inbox",
              "starred"
            ]
          },
          "markReadOnOpen": {
            "type": "boolean"
          },
          "defaultMessageView": {
            "type": "string",
            "enum": [
              "source",
              "rendered"
            ]
          },
          "notificationKinds": {
            "type": "object",
            "properties": {
              "unread": {
                "type": "boolean"
              },
              "snooze": {
                "type": "boolean"
              },
              "error": {
                "type": "boolean"
              }
            }
          },
          "shortcutBindings": {
            "type": "object",
            "properties": {
              "focusSearch": {
                "type": "string",
                "maxLength": 60
              },
              "compose": {
                "type": "string",
                "maxLength": 60
              },
              "sync": {
                "type": "string",
                "maxLength": 60
              },
              "nextMessage": {
                "type": "string",
                "maxLength": 60
              },
              "previousMessage": {
                "type": "string",
                "maxLength": 60
              },
              "reply": {
                "type": "string",
                "maxLength": 60
              },
              "forward": {
                "type": "string",
                "maxLength": 60
              },
              "toggleStar": {
                "type": "string",
                "maxLength": 60
              },
              "markUnread": {
                "type": "string",
                "maxLength": 60
              },
              "archive": {
                "type": "string",
                "maxLength": 60
              },
              "delete": {
                "type": "string",
                "maxLength": 60
              },
              "openShortcutSettings": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        }
      },
      "annotations": {
        "idempotentHint": true
      }
    },
    {
      "name": "theme_custom_get",
      "title": "读取自定义主题",
      "description": "读取当前应用账号由 MCP 保存的安全自定义主题令牌，可复制到 iMail 自定义主题编辑器中。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "theme_custom_update",
      "title": "保存自定义主题",
      "description": "校验并保存颜色、圆角、阴影和字体令牌；不接受 CSS、URL 或可执行内容，也不经过 HTTP 网关。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "canvas": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "surface": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "surfaceSubtle": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "rail": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "text": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "textSecondary": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "border": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "accentSubtle": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "radius": {
            "type": "string",
            "enum": [
              "compact",
              "balanced",
              "rounded"
            ]
          },
          "shadow": {
            "type": "string",
            "enum": [
              "none",
              "soft",
              "offset"
            ]
          },
          "typography": {
            "type": "string",
            "enum": [
              "system",
              "technical",
              "rounded"
            ]
          }
        },
        "required": [
          "name",
          "canvas",
          "surface",
          "surfaceSubtle",
          "rail",
          "text",
          "textSecondary",
          "border",
          "accent",
          "accentSubtle",
          "radius",
          "shadow",
          "typography"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "idempotentHint": true
      }
    },
    {
      "name": "accounts_list",
      "title": "列出邮箱账户",
      "description": "列出所有邮箱账户、连接状态和文件夹，不返回任何凭据。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "account_add_with_code",
      "title": "用邮箱授权码添加账户",
      "description": "使用服务商生成的授权码或应用专用密码添加并验证 IMAP/SMTP 邮箱。凭据加密保存且不会返回。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "outlook",
              "gmail",
              "qq",
              "yahoo",
              "hotmail",
              "icloud",
              "custom"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "authorizationCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "group": {
            "default": "个人",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "groupIcon": {
            "default": "folder",
            "type": "string",
            "enum": [
              "folder",
              "briefcase",
              "building",
              "home",
              "users",
              "code",
              "heart",
              "star"
            ]
          },
          "color": {
            "default": "#168f78",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "settings": {
            "description": "provider=custom 时必须提供完整 IMAP/SMTP 设置",
            "type": "object",
            "properties": {
              "imapHost": {
                "type": "string",
                "minLength": 1
              },
              "imapPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "imapSecure": {
                "type": "boolean"
              },
              "smtpHost": {
                "type": "string",
                "minLength": 1
              },
              "smtpPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "smtpSecure": {
                "type": "boolean"
              }
            },
            "required": [
              "imapHost",
              "imapPort",
              "imapSecure",
              "smtpHost",
              "smtpPort",
              "smtpSecure"
            ]
          },
          "proxy": {
            "description": "可选的 HTTP、HTTPS 或 SOCKS5 代理；密码只会加密保存",
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "https",
                  "socks5"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "username": {
                "type": "string",
                "maxLength": 256
              },
              "password": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "protocol",
              "host",
              "port"
            ]
          }
        },
        "required": [
          "provider",
          "email",
          "displayName",
          "authorizationCode"
        ]
      },
      "annotations": {
        "idempotentHint": false
      }
    },
    {
      "name": "account_start_oauth",
      "title": "开始邮箱 OAuth 授权",
      "description": "为 Gmail、Outlook、Hotmail 或已获准的 Yahoo 生成官方 OAuth 授权网址。用户需在浏览器完成登录。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "outlook",
              "gmail",
              "yahoo",
              "hotmail"
            ]
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          },
          "group": {
            "default": "个人",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "color": {
            "default": "#168f78",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "proxy": {
            "description": "可选的 HTTP、HTTPS 或 SOCKS5 邮件代理",
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "https",
                  "socks5"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "username": {
                "type": "string",
                "maxLength": 256
              },
              "password": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "protocol",
              "host",
              "port"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false
      }
    },
    {
      "name": "account_reconnect_oauth",
      "title": "重新授权 OAuth 邮箱",
      "description": "为已有 OAuth 邮箱生成重新授权网址。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false
      }
    },
    {
      "name": "account_update",
      "title": "更新邮箱账户",
      "description": "更新邮箱显示名称、工作空间、图标或颜色。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "groupIcon": {
            "type": "string",
            "enum": [
              "folder",
              "briefcase",
              "building",
              "home",
              "users",
              "code",
              "heart",
              "star"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "annotations": {
        "idempotentHint": true
      }
    },
    {
      "name": "account_update_authorization_code",
      "title": "更新邮箱授权码",
      "description": "验证并替换非 OAuth 邮箱的授权码或应用专用密码。新凭据加密保存且不会返回。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "authorizationCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "email",
          "authorizationCode"
        ]
      },
      "annotations": {
        "idempotentHint": false
      }
    },
    {
      "name": "account_test_connection",
      "title": "测试邮箱连接",
      "description": "使用已保存凭据测试邮箱的 IMAP 与 SMTP 连接。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "account_proxy_update",
      "title": "更新邮箱代理",
      "description": "启用、修改、关闭账户级代理，或复用另一邮箱的代理。代理密码加密保存且不会返回。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "const": true
                      },
                      "sourceAccountId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    },
                    "required": [
                      "enabled",
                      "sourceAccountId"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "http",
                          "https",
                          "socks5"
                        ]
                      },
                      "host": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "username": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "password": {
                        "type": "string",
                        "maxLength": 512
                      },
                      "enabled": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "protocol",
                      "host",
                      "port",
                      "enabled"
                    ]
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": [
                  "email"
                ]
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "enabled": {
                "type": "boolean",
                "const": true
              },
              "sourceEmail": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "email",
              "enabled",
              "sourceEmail"
            ]
          }
        ]
      },
      "annotations": {
        "idempotentHint": false
      }
    },
    {
      "name": "account_remove",
      "title": "移除邮箱账户",
      "description": "从 iMail 移除账户，并删除该账户的本地邮件缓存。不会删除服务商服务器上的账户。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "mailbox_sync",
      "title": "同步邮箱",
      "description": "从源 IMAP 同步一个或全部邮箱的收件箱、已发送、归档、垃圾箱或指定自定义文件夹。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "description": "不填时同步全部账户",
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "mailboxRole": {
            "default": "inbox",
            "type": "string",
            "enum": [
              "inbox",
              "sent",
              "archive",
              "drafts",
              "trash",
              "junk",
              "custom"
            ]
          },
          "mailboxPath": {
            "description": "指定自定义 IMAP 文件夹路径",
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "annotations": {
        "idempotentHint": true
      }
    },
    {
      "name": "sync_policy_get",
      "title": "读取自动同步设置",
      "description": "读取默认及账户级自动同步设置、邮箱校准状态和最近任务。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "sync_policy_update",
      "title": "更新自动同步设置",
      "description": "更新全局默认设置或指定邮箱的自动同步开关、文件夹范围和失败通知。变化唤醒与后台校准不依赖任何前端连接。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "email": {
            "description": "不填时修改新账户使用的默认策略",
            "type": "string",
